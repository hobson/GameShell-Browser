# Copy to deploy/admin/.env and fill in real values. Never commit .env.

# Random session-cookie signing key, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Output of: python scripts/hash_password.py '<your chosen admin password>'
ADMIN_PASSWORD_HASH=

# Optional, defaults to 7683.
GSH_ADMIN_PORT=7683
