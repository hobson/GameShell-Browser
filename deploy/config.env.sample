# deploy/config.env — per-deployment session defaults, read fresh by
# gsh-session.sh on every new connection (no rebuild, no service restart
# needed to change these). Copy this file to deploy/config.env and edit by
# hand, or manage it through the admin web app in deploy/admin/ instead.
#
# If deploy/config.env doesn't exist at all, gsh-session.sh falls back to
# these same defaults, so an existing deployment that never sets this up
# behaves exactly as before this file was introduced.

# 1 = python/python3 available in the game shell (default). 0 = hidden.
GSH_ENABLE_PYTHON=1

# Which mission list a fresh session boots into. Path relative to the repo
# root, same as start.sh's positional index-file argument
# (see: ./start.sh -Rdq missions/contrib/my_mission).
GSH_INDEX_FILE=missions/default.idx
