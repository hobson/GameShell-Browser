# deploy/config.env — per-deployment session defaults, read fresh by
# gsh-session.sh on every new connection (no rebuild, no service restart
# needed to change these). Copy this file to deploy/config.env and edit by
# hand, or manage it through the admin web app in deploy/admin/ instead.
#
# If deploy/config.env doesn't exist at all, gsh-session.sh falls back to
# these same defaults, so an existing deployment that never sets this up
# behaves exactly as before this file was introduced.

# 1 = python/python3 available in the game shell (default). 0 = hidden.
GSH_ENABLE_PYTHON=1

# Which mission list a fresh session boots into. Path relative to missions/
# (e.g. "default.idx", "contrib/my_mission/default.idx") -- NOT relative to
# the repo root. gsh-session.sh runs the game from a self-extracting archive
# inside Docker, where make_index prefixes every path with $GSH_MISSIONS/
# (see scripts/make_index's GSH_EXEC_FILE branch), so a repo-root-relative
# path like "missions/default.idx" resolves to a nonexistent doubled
# "missions/missions/default.idx". This differs from start.sh's own
# positional index-file argument when run directly from source (e.g.
# ./start.sh -Rdq missions/contrib/my_mission), which IS repo-root-relative.
GSH_INDEX_FILE=default.idx
